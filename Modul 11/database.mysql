CREATE TABLE IF NOT EXISTS t_dosen (
    idDosen INT PRIMARY KEY AUTO_INCREMENT,
    namaDosen VARCHAR(100) NOT NULL,
    noHP VARCHAR(20)
);

CREATE TABLE IF NOT EXISTS t_mahasiswa (
    npm VARCHAR(20) PRIMARY KEY,
    namaMhs VARCHAR(100) NOT NULL,
    prodi VARCHAR(50),
    alamat TEXT,
    noHP VARCHAR(20)
);

CREATE TABLE IF NOT EXISTS t_matakuliah (
    kodeMK VARCHAR(10) PRIMARY KEY,
    namaMK VARCHAR(100) NOT NULL,
    sks INT,
    jam INT
);